  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 906997174}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 32
  indentLevel: 0
  storyText: 'Even metal like you also talk nonsenses? Whatever, tell me metal. Can
    your metal lips feel the vibration of the wood? '
  description: 
  character: {fileID: 1236920736}
  portrait: {fileID: -6150243784136745721, guid: 2a9e196fc8322294f8a8ac9b49817c65, type: 3}
