  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 66
  indentLevel: 0
  storyText: 'In the past in Borneo, a fine set of gongs was not just a musical instrument
    but could be directly used as an expensive bridal dowry (berian) or a symbol
    of wealth. '
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
