  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 67
  indentLevel: 0
  storyText: If you wanted to marry your beloved, your family had to save up a proper
    set of gongs first.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
