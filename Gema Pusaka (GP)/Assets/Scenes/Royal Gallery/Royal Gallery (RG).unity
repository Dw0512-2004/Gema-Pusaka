  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 19
  indentLevel: 0
  storyText: 'The musical pieces played by Nobat were not allowed to be easily recorded
    or taken out of the court by outsiders. '
  description: 
