  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 20
  indentLevel: 0
  storyText: These melodies carry a strong sense of mystery and strict inheritance
    rules, making them part of the royal family's highest secrets.
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
