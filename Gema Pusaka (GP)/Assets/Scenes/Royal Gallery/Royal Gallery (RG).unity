  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 74
  indentLevel: 0
  storyText: 'There is actually a natural ''musical stone'' called ''Batu Gong''
    in Tambunan, Sabah, and striking it really produces a crisp musical tone resembling
    a bronze gong. '
  description: 
  character: {fileID: 0}
  portrait: {fileID: 0}
  voiceOverClip: {fileID: 0}
