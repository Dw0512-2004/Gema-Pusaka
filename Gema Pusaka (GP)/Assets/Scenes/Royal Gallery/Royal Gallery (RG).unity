  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 12
  indentLevel: 0
  storyText: The Kedah Royal Nobat Orchestra in Malaysia has a history of over 400
    years, making it one of the oldest surviving traditional royal musical institutions
    in the country.
