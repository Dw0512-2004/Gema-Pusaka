  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 98
  indentLevel: 0
  storyText: Nusa will choose to remain its mission, to restore Nobat. But Nusa will
    take its own decision to take the instrument with it or leave it where it should
    be.
  description: 
  character: {fileID: 33056751}
  portrait: {fileID: 2838802082477022427, guid: 4d99c0fbd49827f47b1e14f5b4a2276b, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
  extendPrevious: 0
  fadeWhenDone: 1
