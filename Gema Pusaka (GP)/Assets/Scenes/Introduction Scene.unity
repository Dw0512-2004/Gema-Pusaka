--- !u!114 &1270352146
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1270352042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 94
  indentLevel: 0
  storyText: 'The notes should be free; all the notes possess noble souls! If this
    Nusa thing just simply rips the instruments from their resting places like those
    calculated artifacts, it will not act as a musician. '
  description: 
  character: {fileID: 1993605480}
  portrait: {fileID: 2310407082681437704, guid: 9d8ca54b3056d5e44abf16147c56ea7c, type: 3}
