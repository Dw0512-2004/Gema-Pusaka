  stopVoiceover: 1
  waitForVO: 0
  setSayDialog: {fileID: 546239862}
--- !u!114 &1270352143
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1270352042}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 97
  indentLevel: 0
  storyText: "If Nusa leaves the instruments behind in that phantom palace, the music
    might fade into the void! My programming strictly dictates that in every Nusa\u2019s
    decisions."
  description: 
  character: {fileID: 33056751}
  portrait: {fileID: 2838802082477022427, guid: 4d99c0fbd49827f47b1e14f5b4a2276b, type: 3}
