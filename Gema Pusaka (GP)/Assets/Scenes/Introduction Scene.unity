  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 91
  indentLevel: 0
  storyText: 'Nusa calculates optimal airflow in milliseconds, Hamzah. This means
    that Nusa can play Nobat perfectly without any mistakes every time. '
  description: 
  character: {fileID: 33056751}
