  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 102
  indentLevel: 0
  storyText: 'The baseline parameters are set, but the adaptive learning matrix is
    autonomous. Once inside, Nusa will have to weigh my preservation directives against
    your philosophy of musical freedom. It will make its own choices. '
  description: 
  character: {fileID: 33056751}
  portrait: {fileID: 2838802082477022427, guid: 4d99c0fbd49827f47b1e14f5b4a2276b, type: 3}
