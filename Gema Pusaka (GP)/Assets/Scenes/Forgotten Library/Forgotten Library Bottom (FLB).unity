  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 29
  indentLevel: 0
  storyText: 'Velocity! Force! Stop speaking like doing a basic movement. Gong is
    not merely struck; it is awakened. '
  description: 
  character: {fileID: 342001075}
  portrait: {fileID: 21300000, guid: 4d17b62a5de067e478247bcc44106c31, type: 3}
  voiceOverClip: {fileID: 0}
