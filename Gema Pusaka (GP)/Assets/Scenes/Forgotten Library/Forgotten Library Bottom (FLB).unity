  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 43
  indentLevel: 0
  storyText: "Then weigh this now. The Gong\u2019s echo was meant to announce the
    presence of royalty, to travel far beyond these walls. If you take this melody,
    does it echo through the world, or does it die in a glass display case?"
  description: 
  character: {fileID: 342001075}
  portrait: {fileID: 21300000, guid: 4d17b62a5de067e478247bcc44106c31, type: 3}
