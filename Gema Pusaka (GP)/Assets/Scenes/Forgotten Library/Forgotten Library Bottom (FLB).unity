--- !u!114 &23795181
MonoBehaviour:
  m_ObjectHideFlags: 2
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 23795115}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 30
  indentLevel: 0
  storyText: 'A true musician grounds their energy deep within their core before
    the mallet ever moves. '
  description: 
  character: {fileID: 342001075}
  portrait: {fileID: 21300000, guid: 4d17b62a5de067e478247bcc44106c31, type: 3}
  voiceOverClip: {fileID: 0}
  showAlways: 1
  showCount: 1
