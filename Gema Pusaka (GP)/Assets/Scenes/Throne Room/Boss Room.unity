  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 16
  indentLevel: 0
  storyText: A preserved corpse is not a living memory. They deserve freedom, not
    being locked in a silence metal box!
  description: 
  character: {fileID: 671819440}
  portrait: {fileID: -2830071645898275730, guid: c59495260d41a174a9b52eb213430edb, type: 3}
