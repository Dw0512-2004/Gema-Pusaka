  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 13
  indentLevel: 0
  storyText: You restore the Nobat by taking the instruments and store at the royal
    institutions, dragging our heritage into a sterile, breathless cage!
