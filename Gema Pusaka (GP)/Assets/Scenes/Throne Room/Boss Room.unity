  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 50
  indentLevel: 0
  storyText: Tell me, do you truly believe a machine can honor the freedom of the
    music, or are you simply malfunctioning?
  description: 
  character: {fileID: 671819440}
  portrait: {fileID: -2830071645898275730, guid: c59495260d41a174a9b52eb213430edb, type: 3}
