  m_Script: {fileID: 11500000, guid: ec422cd568a9c4a31ad7c36d0572b9da, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Fungus::Fungus.Say
  itemId: 16
  indentLevel: 0
  storyText: A preserved corpse is not a living memory. They deserve freedom, not
    being locked in a silence metal box!
  description: 
  character: {fileID: 671819440}
  portrait: {fileID: 21300000, guid: ea8f56c43254d41728f5ac4e8299b6c9, type: 3}
  voiceOverClip: {fileID: 0}
